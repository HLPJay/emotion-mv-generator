# Optional environment overrides. Normal usage should edit config/model_config.json.
# 1 means use real LLM API. Empty or 0 means use local rule-based fallback.
REFLECTION_LLM_ENABLED=1

# OpenAI-compatible chat-completions endpoint base.
# DeepSeek:
REFLECTION_LLM_API_BASE=https://api.deepseek.com
REFLECTION_LLM_MODEL=deepseek-chat

# OpenAI example:
# REFLECTION_LLM_API_BASE=https://api.openai.com/v1
# REFLECTION_LLM_MODEL=gpt-4.1-mini

# MiniMax/OpenAI-compatible example:
# REFLECTION_LLM_API_BASE=https://api.minimaxi.com/v1
# REFLECTION_LLM_MODEL=MiniMax-M2.7-highspeed

REFLECTION_LLM_API_KEY=replace_with_your_api_key
