# Python caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local env files
.venv/
venv/
env/
.env
.env.*
!.env.example

# Test/build caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Local secrets/config
config/model_config.json

# Runtime logs
*.log
gradio.*.log

# Generated media and run artifacts
generated/*
!generated/images/
generated/images/*
!generated/images/.gitkeep
!generated/videos/
generated/videos/*
!generated/videos/.gitkeep

# Local media scratch files
assets/music/*
!assets/music/.gitkeep

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
